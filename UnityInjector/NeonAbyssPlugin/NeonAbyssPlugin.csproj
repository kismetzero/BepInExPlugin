<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>NeonAbyssPlugin</RootNamespace>
    <AssemblyName>NeonAbyssPlugin</AssemblyName>
    <Deterministic>true</Deterministic>

    <Version>1.0.0</Version>
    <Authors>YourName</Authors>
    <Description>NeonAbyss BepInEx Plugin</Description>
    <Company>YourStudio</Company>
    <Copyright>Copyright © 2026 YourName</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <_GameMainDir>$(GameRootDir)\Neon Abyss</_GameMainDir>
    <_GameManagedDir>$(_GameMainDir)\NeonAbyss_Data\Managed</_GameManagedDir>
    <_GameAvailable Condition="Exists('$(_GameManagedDir)\Assembly-CSharp.dll')">true</_GameAvailable>
  </PropertyGroup>

  <ItemGroup Condition=" '$(_GameAvailable)' == 'true' ">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(_GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(_GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(_GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(_GameManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(_GameAvailable)' != 'true'">
    <Compile Remove="**\*.cs" />
  </ItemGroup>

  <Target Name="CopyToPlugin" AfterTargets="Build">
    <Message Condition=" '$(_GameAvailable)' != 'true' " Text="$(TargetName) 构建失败！游戏不存在。" Importance="High" />
    <Copy
      Condition=" '$(_GameAvailable)' == 'true' "
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(_GameMainDir)"
      SkipUnchangedFiles="true"
      OverwriteReadOnlyFiles="true"
      Retries="3"
      RetryDelayMilliseconds="1000"
    />
    <Message Condition=" '$(_GameAvailable)' == 'true' " Text="$(TargetName) -> $(_GameBepInExPluginDir)" Importance="High" />
  </Target>

</Project>
